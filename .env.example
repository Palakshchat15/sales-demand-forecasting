# Postgres
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sales_forecast
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow (uses its own metadata db inside the same postgres instance)
AIRFLOW_UID=50000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=sales-events

# GenAI provider preference order: GROQ_API_KEY > OPENAI_API_KEY > local Ollama > error
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Absolute path of this project on the host machine (forward slashes), e.g. C:/Users/you/Projects/sales_forecast_project
HOST_PROJECT_DIR=
